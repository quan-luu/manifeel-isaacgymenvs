<?xml version="1.0"?>
<robot name="USB_socket">
    <link name="USB_socket">
        <visual>
            <geometry>
                <mesh filename="../mesh/TVB_mesh/manifeel_usb_socket.obj"/>                  
            </geometry>
        </visual>
        <material name="LightRed">
            <color rgba="1 0.3 0.3 1"/>
        </material>
        <collision>
            <geometry>
                <mesh filename="../mesh/TVB_mesh/manifeel_usb_socket.obj"/>                
            </geometry>
            <sdf resolution="128"/>
        </collision>
    </link>
</robot>
