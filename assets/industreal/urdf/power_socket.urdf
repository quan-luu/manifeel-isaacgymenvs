<?xml version="1.0"?>
<robot name="power_socekt_medium">
    <link name="power_socekt_medium">
        <visual>
            <geometry>
                <mesh filename="../mesh/TVB_mesh/power_socket.obj"/>                     
            </geometry>
            <material name="socket_beige">
                <color rgba="0.80 0.72 0.60 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="../mesh/TVB_mesh/power_socket.obj"/> 
                <!-- <mesh filename="../mesh/TVB_mesh/power_2prongs_socket.obj"/>                -->
            </geometry>
            <sdf resolution="128"/>
        </collision>
    </link>
</robot>
