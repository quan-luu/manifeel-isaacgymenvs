<?xml version="1.0"?>
<robot name="power_socket">
    <link name="power_socket">
        <visual>
            <geometry>
                <mesh filename="../mesh/TVB_mesh/manifeel_power_socket.obj"/>                     
            </geometry>
            <material name="LightRed">
                <color rgba="1 0.3 0.3 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="../mesh/TVB_mesh/manifeel_power_socket.obj"/> 
            </geometry>
            <sdf resolution="128"/>
        </collision>
    </link>
</robot>
