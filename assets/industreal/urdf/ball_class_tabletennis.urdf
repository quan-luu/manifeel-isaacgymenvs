<?xml version="1.0"?>
<robot name="classification_ball">
    <link name="ball">
        <visual>
            <geometry>
                <mesh filename="../mesh/TVB_mesh/ball_task_tabletennis.obj"/>                                   
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="../mesh/TVB_mesh/ball_task_tabletennis.obj"/> 
            </geometry>
            <sdf resolution="128"/>
        </collision>
    </link>
</robot>
